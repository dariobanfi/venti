<?xml version="1.0" encoding="utf-8"?>
<!--
  The app icon: a white paraglider on the accent violet, the pilot a dot in
  the colour a climb has on a track. Android cuts the shape it likes out of
  the two layers; the third is for themed icons, which are one colour.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

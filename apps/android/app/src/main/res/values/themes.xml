<?xml version="1.0" encoding="utf-8"?>
<!--
  What the window looks like before Compose has drawn anything: the design
  pack's background colour (venti_bg, made at build time from
  design/tokens/tokens.json) and no title bar. Everything after that is the
  theme in design/Theme.kt.
-->
<resources>
    <style name="Theme.Venti" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/venti_bg</item>
    </style>
</resources>

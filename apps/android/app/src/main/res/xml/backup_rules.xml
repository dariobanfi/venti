<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android may copy out of the app, up to Android 11: nothing. Those
  versions have one rule for cloud backups and for transfers to a new phone
  alike, and the app tells the pilot that flights stay on the phone.
-->
<full-backup-content>
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="file"
        path="." />
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="external"
        path="." />
</full-backup-content>

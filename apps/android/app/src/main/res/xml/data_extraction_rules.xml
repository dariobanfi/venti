<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android may copy out of the app, from Android 12 on. Nothing goes to a
  cloud backup: the app tells the pilot that flights stay on the phone. A
  transfer from this phone straight to a new one has no rule here, which
  means everything goes along: the logbook moves with its pilot.

  To verify on real phones: nobody has moved a logbook this way yet.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="external"
            path="." />
    </cloud-backup>
</data-extraction-rules>

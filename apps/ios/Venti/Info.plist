<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only what cannot be said as a build setting in project.yml: the app opens
  IGC flight files and XCTSK task files handed to it by Files, Mail and other
  apps, it keeps
  working in the background during a flight, and it names the Venti it was
  built with. Xcode adds the rest of the Info.plist when it builds.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>IGC flight file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.fai.igc</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>XCTSK task file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.xcontest.xctsk</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.fai.igc</string>
			<key>UTTypeDescription</key>
			<string>IGC flight file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>igc</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.xcontest.xctsk</string>
			<key>UTTypeDescription</key>
			<string>XCTSK task file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>xctsk</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/xctsk</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Venti's address, from the build setting VENTI_SERVER (project.yml). -->
	<key>VentiServer</key>
	<string>$(VENTI_SERVER)</string>
	<!-- The Debug build's Venti, and the tests' servers, are on this Mac
	     (127.0.0.1) and are reached without encryption. Everything on the
	     internet is reached over HTTPS only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The design language's typeface, from design/fonts. -->
	<key>UIAppFonts</key>
	<array>
		<string>FiraSans-Regular.ttf</string>
		<string>FiraSans-Italic.ttf</string>
		<string>FiraSans-Medium.ttf</string>
		<string>FiraSans-SemiBold.ttf</string>
		<string>FiraSans-Bold.ttf</string>
		<string>FiraSans-BlackItalic.ttf</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- A flight is recorded, the vario sounds and the Bluetooth vario is
	     heard with the screen off. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
		<string>bluetooth-central</string>
	</array>
</dict>
</plist>

{
	"name": "venti-web",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"core": "scripts/build-core.sh",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"licences": "node scripts/check-licences.mjs",
		"test": "vitest run",
		"test:e2e": "playwright test --trace off"
	},
	"dependencies": {
		"maplibre-gl": "6.19.0"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "22.20.5",
		"binaryen": "132.0.0",
		"fake-indexeddb": "6.2.8",
		"pmtiles": "4.5.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"svelte": "5.58.0",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	}
}

{
	"name": "venti-web",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"core": "scripts/build-core.sh",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"licences": "node scripts/check-licences.mjs",
		"test": "vitest run",
		"test:e2e": "playwright test --trace off"
	},
	"dependencies": {
		"maplibre-gl": "6.14.0"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "3.0.8",
		"@sveltejs/kit": "2.65.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "22.20.5",
		"binaryen": "132.0.0",
		"fake-indexeddb": "6.2.6",
		"pmtiles": "4.5.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.5.0",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}

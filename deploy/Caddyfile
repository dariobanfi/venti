# Caddy in front of Venti: TLS, static files, and the way in to the API.
#
# With a domain name as the site address Caddy obtains and renews its
# certificate by itself; ports 80 and 443 must be reachable from the
# internet and the name must point at this server. With `:80` it serves
# plain HTTP, which is for trying the stack out and nothing else.

{$VENTI_SITE_ADDRESS} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# Unless the server chose one itself. It does for the pages of
		# shared flights and of live tracks: the link to an unlisted
		# flight, or to a live track, is the key to it and must not travel
		# to other sites in the Referer header.
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API. The server compresses its own answers and sets their cache
	# headers, so nothing is added here.
	#
	# The server counts sign-in attempts by client address. Caddy tells it
	# the address in X-Forwarded-For, which it writes itself and does not
	# take over from the client; the server believes that header from this
	# container's address only (VENTI_TRUSTED_PROXIES in docker-compose.yml).
	handle /v1/* {
		reverse_proxy server:8080
	}

	# The page a link to a flight shows, and its preview picture. The server
	# renders both, with headers of its own.
	handle /f/* {
		reverse_proxy server:8080
	}

	# The page a link to a live track shows. Its address holds the track's
	# identifier, and so does the address of a track under /v1/live/ above:
	# whoever has the identifier sees where its pilot is. The server keeps
	# both out of its own log. This file asks Caddy for no access log, and
	# Caddy writes one only where a `log` directive says so (its
	# documentation, read 2026-11-19). Should one ever be added to this
	# site, these two kinds of address have to be left out of it
	# (`log_skip`).
	handle /live/* {
		reverse_proxy server:8080
	}

	# The connector: the server's public tools for a pilot's own assistant,
	# over the Model Context Protocol. The server bounds the size of a
	# request and the time for an answer itself, and counts requests by the
	# client address, which it learns from Caddy as for the API above.
	handle /mcp {
		reverse_proxy server:8080
	}

	# The connector's public tools ask nobody to sign in; a pilot's own
	# logbook does. The server says where an assistant asks for that (its
	# metadata under /.well-known/oauth-*) and is itself the place: the page
	# on which the pilot agrees, the token endpoint and the rest are under
	# /oauth/. Without these an assistant would be handed the web app's page
	# below.
	handle /.well-known/oauth-* {
		reverse_proxy server:8080
	}
	handle /oauth/* {
		reverse_proxy server:8080
	}
	handle /.well-known/openid-configuration* {
		reverse_proxy server:8080
	}

	# Map tiles: PMTiles archives of several gigabytes that map clients read
	# piece by piece with HTTP range requests, which the file server answers
	# by itself. The archives are compressed inside, so they are not encoded
	# again. An archive is replaced under a new name, never changed in
	# place, so it may be cached for a long time.
	handle_path /tiles/* {
		root * /srv/tiles
		header Cache-Control "public, max-age=604800"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	# The web app: a static build in which every page is a folder with an
	# index.html in it. An address gets its own page; one that is neither a
	# file nor a page gets the entry page. (`try_files {path}` alone does
	# not take a folder for a file, and gave every page the entry page.)
	handle {
		root * /srv/web
		# The app's pages are shown in no frame, on this site or another:
		# a page that frames them could put its own picture over the
		# button that deletes a pilot's account and have the pilot click
		# it. And they take no <base>, which would send the addresses in
		# the page somewhere else. X-Frame-Options says the first again
		# for browsers that predate the policy.
		#
		# What a page may load and run, the web app's build writes into
		# each page itself (apps/web/AGENTS.md); a browser holds a page to
		# both lists.
		#
		# A worker is held to neither. It is held to the policy that
		# arrives with its own script, and the app has two workers: the
		# core, which reads the pilot's session token and talks to the
		# API, and the map engine. So the app's script files arrive with
		# a list of their own: scripts and WebAssembly from this site,
		# requests to this site and the map's two tile hosts, nothing
		# else. A browser reads that list only where a script is started
		# as a worker; for a script a page loads it means nothing. The
		# two hosts are the ones in apps/web/src/lib/map/online.ts, and
		# CI fails when the two files disagree.
		#
		# The two matchers leave no file out and none in both: Caddy
		# runs one `header` after the other, and the second would write
		# over the first. A path that is no file gets the entry page
		# whatever it ends in, so the scripts' list forbids framing too.
		@scripts path *.js *.mjs
		@pages not path *.js *.mjs
		header @pages Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'"
		header @scripts Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://tiles.openfreemap.org https://tiles.mapterhorn.com; frame-ancestors 'none'; base-uri 'none'"
		header X-Frame-Options "DENY"
		encode zstd gzip
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

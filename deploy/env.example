# Settings of the Venti deployment. Copy this file to `.env` in the same
# folder and fill it in. `.env` is ignored by git: it holds a password and
# must never be committed.

# Where the site is served. A domain name that points at this server gives
# automatic HTTPS. `:80` serves plain HTTP, for a first try without a domain.
VENTI_SITE_ADDRESS=:80

# Password of the database user. It ends up inside a URL, so use letters
# and digits only. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# The address people reach the site at, without a slash at the end, for
# example https://venti.example. Links to shared flights are built from it,
# and the previews that chat apps make of such a link only work when it is
# right. Empty is fine until a flight is shared.
VENTI_PUBLIC_URL=

# Who may create an account: invite (the default), open or closed.
# By invite, each account needs a code made with
#   docker compose exec server venti-server invite
VENTI_REGISTRATION=

# Optional: the User-Agent sent to data providers. Some ask operators to
# name a contact, for example "venti-server/0.1 (+https://your-site.example/contact)".
# Empty means the program's name and version only.
VENTI_USER_AGENT=

# Optional: the Overpass API instance that is asked for the flying sites of
# OpenStreetMap, once a day: the address of its interpreter. Empty means the
# main public one, https://overpass-api.de/api/interpreter. Name another, or
# your own, if that one refuses this server.
VENTI_OVERPASS_URL=

# Optional: web origins allowed to call the API from a browser, separated by
# commas. The web app served by this same Caddy needs none: it is same-origin.
# These origins, and VENTI_PUBLIC_URL, are also the only web pages that may
# call the connector for assistants (/mcp) from a browser.
VENTI_CORS_ORIGINS=

# Optional: error, warn, info (default), debug or trace.
VENTI_LOG_LEVEL=

# Optional: whole calendar months of observations to keep (default 13) and
# days of raw provider payloads to keep (default 14).
VENTI_OBSERVATION_MONTHS=
VENTI_ARCHIVE_DAYS=

# Optional: folders on this machine with the web app's static build and
# with the map tiles. Defaults: ./data/web and ./data/tiles.
VENTI_WEB_DIR=
VENTI_TILES_DIR=

# Optional, read by backup.sh: where dumps go and how many days are kept.
# A dump holds every account and every flight as they were that night, so
# an account its owner deleted is still in the dumps for this many days.
VENTI_BACKUP_DIR=
VENTI_BACKUP_KEEP_DAYS=

# Optional: the first three numbers of the private network the three
# services talk on (default 172.30.250, which makes the network
# 172.30.250.0/24). The server believes what Caddy says about a visitor's
# address, and Caddy is known to it by its address in this network. Change
# it only if that range is already used on this machine.
VENTI_NETWORK=

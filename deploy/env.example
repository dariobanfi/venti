# Settings of the Venti deployment. Copy this file to `.env` in the same
# folder and fill it in. `.env` is ignored by git: it holds a password and
# must never be committed.

# Where the site is served. A domain name that points at this server gives
# automatic HTTPS. `:80` serves plain HTTP, for a first try without a domain.
#
# !! WITH `:80` NOTHING IS ENCRYPTED. A password typed into the app, and the
# !! token that signs a device in, cross the network readable to anyone on
# !! the way. Look at the wind and the airspace with it; do not create
# !! accounts. That is why VENTI_REGISTRATION below is "closed" in this
# !! file: change both together, the address to your domain name and the
# !! registration to "invite".
VENTI_SITE_ADDRESS=:80

# Where the site listens on this machine: the address and port for HTTP,
# and for HTTPS. Left out, it listens on every IPv4 address of the machine,
# ports 80 and 443, which is what a server wants. For a stack on one's own
# computer, only for oneself, keep it to that computer:
#   VENTI_HTTP_BIND=127.0.0.1:8088
#   VENTI_HTTPS_BIND=127.0.0.1:8443
# The site is then at http://127.0.0.1:8088 and nowhere on the network.
#VENTI_HTTP_BIND=0.0.0.0:80
#VENTI_HTTPS_BIND=0.0.0.0:443

# Password of the database role the server signs in as ("venti"). It ends
# up inside a URL, so use letters and digits only. Generate one with:
#   openssl rand -hex 24
# The database's superuser has no password and is reached from inside its
# container only; see README.md, "What each service may do".
POSTGRES_PASSWORD=

# The address people reach the site at, without a slash at the end, for
# example https://venti.example. Links to shared flights are built from it,
# and the previews that chat apps make of such a link only work when it is
# right. Empty is fine until a flight is shared.
VENTI_PUBLIC_URL=

# Who may create an account: invite, open or closed. Left empty, the server
# takes accounts by invite. It is "closed" here because this file starts
# out without HTTPS (see VENTI_SITE_ADDRESS above): set it to "invite" once
# the site has its domain name. By invite, each account needs a code made
# with
#   docker compose exec server venti-server invite
VENTI_REGISTRATION=closed

# Optional: "true" lets pilots add flying sites of their own and correct
# them. What they give is given under CC0 1.0 and stays when the account
# goes. Empty means no: the terms that say so to a pilot are not written
# yet, so turn it on only while every pilot on this server is your own.
VENTI_SITES_FROM_PILOTS=

# Optional: how much one account may keep. Defaults: 25000 flights and
# 4096 megabytes of flight files (counted as uploaded; the database stores
# them in about a third). No pilot reaches these by flying; they keep one
# account from filling the disk.
VENTI_ACCOUNT_FLIGHTS=
VENTI_ACCOUNT_STORAGE_MB=

# Optional: the User-Agent sent to data providers. Some ask operators to
# name a contact, for example "venti-server/0.1 (+https://your-site.example/contact)".
# Empty means the program's name and version only.
VENTI_USER_AGENT=

# Optional: the Overpass API instance that is asked for the flying sites of
# OpenStreetMap, once a day: the address of its interpreter. Empty means the
# main public one, https://overpass-api.de/api/interpreter. Name another, or
# your own, if that one refuses this server.
VENTI_OVERPASS_URL=

# Optional: the Open-Meteo instance that is asked for forecasts, one that
# you run yourself. Empty means the server has no forecasts and says so; it
# never asks Open-Meteo's public service. The Compose file holds an
# instance that is started with `--profile forecasts` and is then at
# http://open-meteo:8080. README.md, "Forecasts", has the steps.
VENTI_OPEN_METEO_URL=

# Optional, for that instance: the size of its cache on disk (default 8GB).
OPEN_METEO_CACHE_SIZE=

# Optional: web origins allowed to call the API from a browser, separated by
# commas. The web app served by this same Caddy needs none: it is same-origin.
# These origins, and VENTI_PUBLIC_URL, are also the only web pages that may
# call the connector for assistants (/mcp) from a browser.
VENTI_CORS_ORIGINS=

# Optional: error, warn, info (default), debug or trace.
VENTI_LOG_LEVEL=

# Optional: whole calendar months of observations to keep (default 13) and
# days of raw provider payloads to keep (default 14).
VENTI_OBSERVATION_MONTHS=
VENTI_ARCHIVE_DAYS=

# Optional: the most megabytes of map imagery the server keeps on its disk
# (default 20480, 20 GB). Over it, the tiles written longest ago are
# removed. The tiles are Austria's orthophoto, cut at the border.
VENTI_IMAGERY_CACHE_MB=

# Optional: hours a live track is kept after its newest position, before
# it is removed with its positions (default 48).
VENTI_LIVE_HOURS=

# Optional: days a report that a pilot sent is kept after you closed it
# (default 90). A report that is still open is kept until it is closed.
VENTI_REPORT_DAYS=

# Optional: days a plan that the members of a group made for a flying day
# is kept after that day, before it is removed with who was in (default 2).
VENTI_PLAN_DAYS=

# Optional: the folder on this machine with the map tiles. Default:
# ./data/tiles. (The web app needs no folder: it is built into an image
# and put where Caddy serves it at every start.)
VENTI_TILES_DIR=

# Optional: the folder on this machine with the map regions the server
# hands out for download, one folder in it for each region. Default:
# ./data/maps. While it is empty the server hands out none. README.md,
# "Map regions", says what goes in it and how a region is renewed.
VENTI_MAPS_DIR=

# Optional, read by backup.sh: where dumps go and how many days are kept.
# A dump holds every account and every flight as they were that night, so
# an account its owner deleted is still in the dumps for this many days.
VENTI_BACKUP_DIR=
VENTI_BACKUP_KEEP_DAYS=

# Optional: the most memory each service may take (defaults: 256m, 1g, 2g,
# which fit a machine with 4 GB). Give the database more on a larger one.
VENTI_CADDY_MEMORY=
VENTI_SERVER_MEMORY=
VENTI_DB_MEMORY=

# Optional: the first three numbers of the private network the three
# services talk on (default 172.30.250, which makes the network
# 172.30.250.0/24). The server believes what Caddy says about a visitor's
# address, and Caddy is known to it by its address in this network. Change
# it only if that range is already used on this machine.
VENTI_NETWORK=

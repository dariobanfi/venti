{
  "version": 8,
  "name": "Venti",
  "metadata": {
    "about": "The one map style shared by the iOS, Android and web apps. Vector data follows the OpenMapTiles schema. The three __…__ placeholders are replaced by each app with the URLs of its tiles and fonts, local or remote."
  },
  "glyphs": "__GLYPHS_URL__/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "__BASEMAP_URL__"
    },
    "terrain": {
      "type": "raster-dem",
      "url": "__TERRAIN_URL__",
      "tileSize": 512,
      "encoding": "terrarium"
    }
  },
  "layers": [
    {
      "id": "land",
      "type": "background",
      "paint": { "background-color": "#f1f0e7" }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "farmland"]]],
      "paint": { "fill-color": "#e6edd6" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#cfe1bf" }
    },
    {
      "id": "landcover-rock",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["rock", "sand"]]],
      "paint": { "fill-color": "#e3dfd8" }
    },
    {
      "id": "landcover-ice",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "ice"],
      "paint": { "fill-color": "#f3fbff" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "commercial", "industrial", "retail"]]],
      "paint": { "fill-color": "#e9e4da" }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "terrain",
      "paint": {
        "hillshade-exaggeration": 0.45,
        "hillshade-shadow-color": "#4a4336",
        "hillshade-highlight-color": "#ffffff",
        "hillshade-accent-color": "#6b6252"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "basemap",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#9cc7e3",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 14, 2]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": { "fill-color": "#a8cfe8" }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "basemap",
      "source-layer": "building",
      "minzoom": 14,
      "paint": { "fill-color": "#d8d1c5" }
    },
    {
      "id": "path",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["==", ["get", "class"], "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#b5462f",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 16, 1.6],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "track",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "track"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#9a7b55",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 16, 2],
        "line-dasharray": [5, 2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "tertiary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 16, 5]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f6d38a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 16, 8]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "#6d6d6d",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 16, 2],
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "aerialway",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "aerialway"],
      "paint": {
        "line-color": "#222222",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 16, 2]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#8d7a9c",
        "line-width": 1,
        "line-dasharray": [4, 3]
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["noto-sans-regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#2f6f96",
        "text-halo-color": "#e6f2fa",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "peak",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "mountain_peak",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "case",
          ["has", "ele"],
          ["concat", ["get", "name"], "\n", ["to-string", ["get", "ele"]], " m"],
          ["get", "name"]
        ],
        "text-font": ["noto-sans-regular"],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4a3b2a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "village", "hamlet"]]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["noto-sans-regular"],
        "text-size": [
          "match",
          ["get", "class"],
          "city", 16,
          "town", 14,
          "village", 12,
          11
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#2b2b2b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}

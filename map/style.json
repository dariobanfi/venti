{
  "version": 8,
  "name": "Venti",
  "metadata": {
    "about": "The one map style shared by the iOS, Android and web apps. Its colours are the design language's map colours for the light theme (design/tokens, map.light), and no others. Vector data follows the OpenMapTiles schema. The glyphs URL and the URLs of the base map and the terrain are placeholders in capitals that each app replaces with the URLs of its tiles and fonts, local or remote. The map has two views, the drawn ground and the aerial view: photographs from above, laid over the drawn ground and under the names and everything an app draws. A layer that belongs to one view only says so in its metadata, venti:view, as drawn or aerial; an app shows the layers of the view the pilot chose and hides the other's, and every other layer stays. The file stands in the drawn view, and nothing of the photographs is fetched while they are hidden. The world's and Bavaria's are fetched from their providers, at addresses that are the same for every app. Austria's come through Venti, which cuts them at the border: the address begins with a placeholder for the Venti server an app talks to, and an app that has none leaves that source and its layer out. docs/data-sources.md has each provider's terms."
  },
  "glyphs": "__GLYPHS_URL__/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "__BASEMAP_URL__"
    },
    "terrain": {
      "type": "raster-dem",
      "url": "__TERRAIN_URL__",
      "tileSize": 512,
      "encoding": "terrarium"
    },
    "aerial-world": {
      "type": "raster",
      "tiles": [
        "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless_3857/default/GoogleMapsCompatible/{z}/{y}/{x}.jpg"
      ],
      "tileSize": 256,
      "maxzoom": 13,
      "attribution": "<a href=\"https://cloudless.eox.at\">EOxCloudless</a> by <a href=\"https://eox.at\">EOX IT Services GmbH</a> (Contains modified Copernicus Sentinel data 2016 &amp; 2017)"
    },
    "aerial-austria": {
      "type": "raster",
      "tiles": ["__VENTI_SERVER__/v1/imagery/basemap-at/{z}/{x}/{y}"],
      "tileSize": 256,
      "maxzoom": 19,
      "bounds": [9.5307, 46.3723, 17.1608, 49.0205],
      "attribution": "<a href=\"https://basemap.at\">Datenquelle: basemap.at</a>"
    },
    "aerial-bavaria": {
      "type": "raster",
      "tiles": ["https://wmtsod1.bayernwolke.de/wmts/by_dop/smerc/{z}/{x}/{y}"],
      "tileSize": 256,
      "maxzoom": 19,
      "bounds": [8.9451, 47.2485, 13.9089, 50.5799],
      "attribution": "© Datenquellen: <a href=\"https://www.geodaten.bayern.de\">Bayerische Vermessungsverwaltung</a>, Europäische Union, enthält Copernicus Sentinel-2 Daten 2018, verarbeitet durch das Bundesamt für Kartographie und Geodäsie (BKG)"
    }
  },
  "layers": [
    {
      "id": "land",
      "type": "background",
      "paint": { "background-color": "#F7EFDD" }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "farmland"]]],
      "paint": { "fill-color": "#DAE4C5", "fill-opacity": 0.5 }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#DAE4C5" }
    },
    {
      "id": "landcover-rock",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["rock", "sand"]]],
      "paint": { "fill-color": "#C9B9C9", "fill-opacity": 0.25 }
    },
    {
      "id": "landcover-ice",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "ice"],
      "paint": { "fill-color": "#FFFFFF" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "commercial", "industrial", "retail"]]],
      "paint": { "fill-color": "#C9B9C9", "fill-opacity": 0.18 }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "terrain",
      "paint": {
        "hillshade-exaggeration": ["interpolate", ["linear"], ["zoom"], 6, 0.22, 11, 0.45],
        "hillshade-shadow-color": "#5A4284",
        "hillshade-highlight-color": "#FFF4DA",
        "hillshade-accent-color": "#A894B4"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "basemap",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#99D5CA",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 14, 2]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": { "fill-color": "#99D5CA" }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "basemap",
      "source-layer": "building",
      "minzoom": 14,
      "paint": { "fill-color": "#C9B9C9" }
    },
    {
      "id": "aerial-world",
      "type": "raster",
      "metadata": { "venti:view": "aerial" },
      "source": "aerial-world",
      "layout": { "visibility": "none" }
    },
    {
      "id": "aerial-austria",
      "type": "raster",
      "metadata": { "venti:view": "aerial" },
      "source": "aerial-austria",
      "minzoom": 11,
      "layout": { "visibility": "none" }
    },
    {
      "id": "aerial-bavaria",
      "type": "raster",
      "metadata": { "venti:view": "aerial" },
      "source": "aerial-bavaria",
      "minzoom": 11,
      "layout": { "visibility": "none" }
    },
    {
      "id": "aerial-road",
      "type": "line",
      "metadata": { "venti:view": "aerial" },
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]],
      "layout": { "visibility": "none", "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FFFFFF",
        "line-opacity": 0.55,
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.6, 16, 3]
      }
    },
    {
      "id": "path",
      "type": "line",
      "metadata": { "venti:view": "drawn" },
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["==", ["get", "class"], "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#A894B4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 16, 1.6],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "track",
      "type": "line",
      "metadata": { "venti:view": "drawn" },
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "track"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#A894B4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 16, 2],
        "line-dasharray": [5, 2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "metadata": { "venti:view": "drawn" },
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "tertiary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 16, 5]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "metadata": { "venti:view": "drawn" },
      "source": "basemap",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 16, 8]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "metadata": { "venti:view": "drawn" },
      "source": "basemap",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "#A894B4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 16, 2],
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "aerial-aerialway-casing",
      "type": "line",
      "metadata": { "venti:view": "aerial" },
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "aerialway"],
      "layout": { "visibility": "none" },
      "paint": {
        "line-color": "#FFF8E8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 2.4, 16, 4.5]
      }
    },
    {
      "id": "aerialway",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "aerialway"],
      "paint": {
        "line-color": "#221640",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 16, 2]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#A894B4",
        "line-width": 1,
        "line-dasharray": [4, 3]
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["noto-sans-regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#221640",
        "text-halo-color": "#FFF8E8",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "peak",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "mountain_peak",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "case",
          ["has", "ele"],
          ["concat", ["get", "name"], "\n", ["to-string", ["get", "ele"]], " m"],
          ["get", "name"]
        ],
        "text-font": ["noto-sans-regular"],
        "text-size": 11,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#221640",
        "text-halo-color": "#FFF8E8",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "village", "hamlet"]]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["noto-sans-regular"],
        "text-size": [
          "match",
          ["get", "class"],
          "city", 16,
          "town", 14,
          "village", 12,
          11
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#221640",
        "text-halo-color": "#FFF8E8",
        "text-halo-width": 1.6
      }
    }
  ]
}
